{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "moduleDetection": "force"
  },
  "include": [
    "supabase/functions/**/*.ts",
    "scripts/deno-shim.d.ts"
  ]
}
